# Copy to .env for local overrides. No secrets are required.
# The Elexon Insights API is public.

ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=3
CACHE_TTL_SECONDS=900
# Comma-separated browser origins, or * for this read-only public API.
CORS_ORIGINS=*
NEAR_ZERO_MW=1
LOG_LEVEL=INFO
FORECAST_LEAD_DAYS=4
CHUNK_DAYS=7
MAX_RANGE_DAYS=31

# Frontend build. Leave empty in local development so Vite proxies /api.
# On Vercel, set this to the deployed backend origin, with no trailing slash.
VITE_API_BASE_URL=
